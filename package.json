{
  "name": "mapped",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/check-size.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "geo": "node scripts/build-geo.ts",
    "build-flags": "tsx scripts/build-flags.ts",
    "deploy": "! grep -q REPLACE_WITH wrangler.jsonc && npm run build && wrangler d1 migrations apply mapped --remote && wrangler deploy",
    "serve:e2e": "rm -rf .wrangler/e2e && wrangler d1 migrations apply mapped --local --persist-to .wrangler/e2e && wrangler dev --port 4173 --local-upstream localhost:4173 --persist-to .wrangler/e2e --var AUTH_MODE:fake --var AUTH_SECRET:e2e-secret --var GOOGLE_CLIENT_SECRET:unused",
    "recompute-bests": "wrangler d1 execute mapped --file scripts/recompute-bests.sql",
    "dev:full": "npm run build && wrangler d1 migrations apply mapped --local && wrangler dev --port 8787 --local-upstream localhost:8787"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "flag-icons": "^7.5.0",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.147.0"
  }
}
